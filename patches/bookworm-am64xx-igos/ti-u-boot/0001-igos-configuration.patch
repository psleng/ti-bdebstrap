@@ -0,0 +1,456 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Board specific initialization for AM642 EVM
+ *
+ * Copyright (C) 2020-2022 Texas Instruments Incorporated - https://www.ti.com/
+ *	Keerthy <j-keerthy@ti.com>
+ *
+ */
+
+#include <common.h>
+#include <asm/io.h>
+#include <dm/uclass.h>
+#include <k3-ddrss.h>
+#include <net.h>
+#include <spl.h>
+#include <fdt_support.h>
+#include <asm/gpio.h>
+#include <asm/arch/hardware.h>
+#include <asm/arch/sys_proto.h>
+#include <env.h>
+#include <dm.h>
+#include <i2c.h>
+#include <string.h>
+#include <fs.h>  /* Required for fs_set_blk_dev and fs_write */
+#include "../common/k3-ddr-init.h"
+
+#define DEFAULT_PROD_ID		"igos"
+#define DEFAULT_MODEL_ID		"1000"
+
+#define PERLE_EEP_HDR_MAGIC		__builtin_bswap32(0x50534C00)		/* PSL\0 */
+
+#define PERLE_SERIAL_LEN		16
+#define PERLE_VENDOR_LEN		16
+#define PERLE_UUID_LEN			16
+#define PERLE_PROD_ID_LEN		16
+#define PERLE_MODEL_LEN		16
+#define PERLE_SSID_LEN			16
+#define PERLE_PASSWORD_LEN		16
+#define PERLE_MAC_ADDR_LEN		6
+
+#define PERLE_WIFI_MAC_ADDR_CNT	4
+#define PERLE_ETH_MAC_ADDR_CNT	    9
+
+struct perle_am_eeprom {
+	uint32_t magic;
+	uint16_t version;
+	uint8_t reserved1[10];
+	char vendor[PERLE_VENDOR_LEN];
+	char serial[PERLE_SERIAL_LEN];
+	uint8_t uuid[PERLE_UUID_LEN];
+	char prod_id[PERLE_PROD_ID_LEN];
+	char model[PERLE_MODEL_LEN];
+	char ssid[PERLE_SSID_LEN];
+	char password[PERLE_PASSWORD_LEN];
+	uint8_t reserved2[50];
+	uint8_t wifi_mac_addr[PERLE_WIFI_MAC_ADDR_CNT][PERLE_MAC_ADDR_LEN];
+	uint8_t eth_mac_addr[PERLE_ETH_MAC_ADDR_CNT][PERLE_MAC_ADDR_LEN];
+} __attribute__ ((__packed__));
+
+/* Memory location to keep a copy of the AM6 board info record */
+#define PERLE_AM6_EEPROM_BD_INFO_DATA ((struct perle_am_eeprom *) \
+					     TI_SRAM_SCRATCH_BOARD_EEPROM_START)
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int board_init(void)
+{
+	return 0;
+}
+
+#if defined(CONFIG_SPL_LOAD_FIT)
+int board_fit_config_name_match(const char *name)
+{
+	return 0;
+}
+#endif
+
+#if defined(CONFIG_SPL_BUILD)
+#if CONFIG_IS_ENABLED(USB_STORAGE)
+static int fixup_usb_boot(const void *fdt_blob)
+{
+	int ret = 0;
+
+	switch (spl_boot_device()) {
+	case BOOT_DEVICE_USB:
+		/*
+		 * If the boot mode is host, fixup the dr_mode to host
+		 * before cdns3 bind takes place
+		 */
+		ret = fdt_find_and_setprop((void *)fdt_blob,
+					   "/bus@f4000/cdns-usb@f900000/usb@f400000",
+					   "dr_mode", "host", 5, 0);
+		if (ret)
+			printf("%s: fdt_find_and_setprop() failed:%d\n",
+			       __func__, ret);
+		fallthrough;
+	default:
+		break;
+	}
+
+	return ret;
+}
+#endif
+
+void spl_perform_fixups(struct spl_image_info *spl_image)
+{
+	if (IS_ENABLED(CONFIG_K3_INLINE_ECC))
+		fixup_ddr_driver_for_ecc(spl_image);
+	else
+		fixup_memory_node(spl_image);
+
+#if CONFIG_IS_ENABLED(USB_STORAGE)
+	fixup_usb_boot(spl_image->fdt_addr);
+#endif
+}
+#endif
+
+#ifdef CONFIG_PERLE_I2C_BOARD_DETECT
+static void dump_eeprom(void)
+{
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	if (ep->magic == PERLE_EEP_HDR_MAGIC) {
+		int i;
+
+		printf("== EEPROM data ====================================\n");
+		printf("MAGIC        : 0x%08X\n", ep->magic);
+		printf("VERSION      : 0x%04X\n", ep->version);
+		printf("SERIAL       : %.*s\n", PERLE_SERIAL_LEN, ep->serial);
+		printf("PROD_ID      : %.*s\n", PERLE_PROD_ID_LEN, ep->prod_id);
+		printf("MODEL        : %.*s\n", PERLE_MODEL_LEN, ep->model);
+		printf("SSID         : %.*s\n", PERLE_SSID_LEN, ep->ssid);
+		printf("PASSWORD     : %.*s\n", PERLE_PASSWORD_LEN, ep->password);
+		for (i = 0; i < PERLE_WIFI_MAC_ADDR_CNT; i++) {
+			if (is_valid_ethaddr(ep->wifi_mac_addr[i])) {
+				printf("WIFI_MAC[%d]  : %pM\n", i, ep->wifi_mac_addr[i]);
+			} else {
+				printf("WIFI_MAC[%d]  : %pM (## Invalid Mac Addr)\n", i, ep->wifi_mac_addr[i]);
+			}
+		}
+		for (i = 0; i < PERLE_ETH_MAC_ADDR_CNT; i++) {
+			if (is_valid_ethaddr(ep->eth_mac_addr[i])) {
+				printf("ETH_MAC[%d]   : %pM\n", i, ep->eth_mac_addr[i]);
+			} else {
+				printf("ETH_MAC[%d]   : %pM (## Invalid Mac Addr)\n", i, ep->eth_mac_addr[i]);
+			}
+		}
+		printf("===================================================\n");
+	} else {
+		printf("ERROR: ## EEPROM data is not valid!\n");
+	}
+}
+
+int do_board_detect(void)
+{
+	int rc = 0;
+	int bus_addr, dev_addr;
+	u32 header, size;
+	uint8_t offset_test;
+	bool one_byte_addressing = true;
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	bus_addr = CONFIG_EEPROM_BUS_ADDRESS;
+	dev_addr = CONFIG_EEPROM_CHIP_ADDRESS;
+	header = PERLE_EEP_HDR_MAGIC;
+	size = sizeof(*ep);
+
+	if (ep->magic == header) {
+		debug("%s: EEPROM has already been read\n", __func__);
+		return 0;
+	}
+
+#if CONFIG_IS_ENABLED(DM_I2C)
+	struct udevice *dev;
+	struct udevice *bus;
+
+	rc = uclass_get_device_by_seq(UCLASS_I2C, bus_addr, &bus);
+	if (rc)
+		return rc;
+	rc = dm_i2c_probe(bus, dev_addr, 0, &dev);
+	if (rc)
+		return rc;
+
+	/*
+	 * Try 1-byte addressing first
+	 */
+	rc = i2c_set_chip_offset_len(dev, 1);
+	if (rc)
+		return rc;
+
+	/*
+	 * Skip checking result here since this could be a valid i2c read fail
+	 * on some boards that use 2 byte addressing.
+	 * We must allow for fall through to check the data if 2 byte
+	 * addressing works
+	 */
+	(void)dm_i2c_read(dev, 0, (uint8_t *)ep, size);
+	if (ep->magic != header) {
+		printf("WARNING: Magic from EEPROM %08X. Expected %08X\n", ep->magic, header);
+		one_byte_addressing = false;
+	}
+
+	/*
+	 * Handle case of bad 2 byte eeproms that responds to 1 byte addressing
+	 * but gets stuck in const addressing when read requests are performed
+	 * on offsets. We perform an offset test to make sure it is not a 2 byte
+	 * eeprom that works with 1 byte addressing but just without an offset
+	 */
+
+	rc = dm_i2c_read(dev, 0x1, &offset_test, sizeof(offset_test));
+	if (rc || offset_test != ((uint8_t *)&header)[1])
+		one_byte_addressing = false;
+
+	/* Corrupted data??? */
+	if (!one_byte_addressing) {
+		/*
+		 * read the eeprom header using i2c again, but use only a
+		 * 2 byte address (some newer boards need this..)
+		 */
+		rc = i2c_set_chip_offset_len(dev, 2);
+		if (rc)
+			return rc;
+
+		rc = dm_i2c_read(dev, 0, (uint8_t *)ep, size);
+		if (rc)
+			return rc;
+	}
+	if (*((u32 *)ep) != header)
+		return -1;
+#else
+	u32 byte;
+
+	gpi2c_init();
+	rc = ti_i2c_eeprom_init(bus_addr, dev_addr);
+	if (rc)
+		return rc;
+
+	/*
+	 * Read the header first then only read the other contents.
+	 */
+	byte = 1;
+
+	/*
+	 * Skip checking result here since this could be a valid i2c read fail
+	 * on some boards that use 2 byte addressing.
+	 * We must allow for fall through to check the data if 2 byte
+	 * addressing works
+	 */
+	(void)i2c_read(dev_addr, 0x0, byte, (uint8_t *)ep, size);
+	if (ep->magic != header)
+		one_byte_addressing = false;
+
+	/*
+	 * Handle case of bad 2 byte eeproms that responds to 1 byte addressing
+	 * but gets stuck in const addressing when read requests are performed
+	 * on offsets. We perform an offset test to make sure it is not a 2 byte
+	 * eeprom that works with 1 byte addressing but just without an offset
+	 */
+
+	rc = i2c_read(dev_addr, 0x1, byte, &offset_test, sizeof(offset_test));
+	if (rc || offset_test != ((uint8_t *)&header)[1])
+		one_byte_addressing = false;
+
+	/* Corrupted data??? */
+	if (!one_byte_addressing) {
+		/*
+		 * read the eeprom header using i2c again, but use only a
+		 * 2 byte address (some newer boards need this..)
+		 */
+		byte = 2;
+		rc = i2c_read(dev_addr, 0x0, byte, (uint8_t *)ep, size);
+		if (rc)
+			return rc;
+	}
+	if (ep->magic != header)
+		return -1;
+#endif
+
+	dump_eeprom();
+
+	return rc;
+}
+
+int checkboard(void)
+{
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	if (!do_board_detect()) {
+		printf("Ver %x, Model: %s-%s\n", ep->version, ep->prod_id, ep->model);
+	}
+
+	return 0;
+}
+
+#ifdef CONFIG_BOARD_LATE_INIT
+static void setup_board_eeprom_env(void)
+{
+	char board_name[128];
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	if (do_board_detect()) {
+		env_set("prod_id", DEFAULT_PROD_ID);
+		env_set("model", DEFAULT_MODEL_ID);
+		snprintf(board_name, sizeof(board_name), "%s-%s", DEFAULT_PROD_ID, DEFAULT_MODEL_ID);
+	} else {
+		env_set("prod_id", ep->prod_id);
+		env_set("model", ep->model);
+		snprintf(board_name, sizeof(board_name), "%s-%s", ep->prod_id, ep->model);
+	}
+	env_set("board_name", board_name);
+}
+
+static void setup_serial(void)
+{
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	env_set("serial#", ep->serial);
+}
+
+static void set_env_mac_addr(void)
+{
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+
+	if (!do_board_detect()) {
+		int i;
+
+		for (i = 0; i < PERLE_WIFI_MAC_ADDR_CNT; i++) {
+			if (is_valid_ethaddr(ep->wifi_mac_addr[i])) {
+				eth_env_set_enetaddr_by_index("wifi", i, ep->wifi_mac_addr[i]);
+			} else {
+				debug("Invalid wifi mac%d address (%pM)\n", i, ep->wifi_mac_addr[i]);
+			}
+		}
+		for (i = 0; i < PERLE_ETH_MAC_ADDR_CNT; i++) {
+			if (is_valid_ethaddr(ep->eth_mac_addr[i])) {
+				eth_env_set_enetaddr_by_index("eth", i, ep->eth_mac_addr[i]);
+			} else {
+				debug("Invalid eth mac%d address (%pM)\n", i, ep->eth_mac_addr[i]);
+			}
+		}
+	}
+}
+
+/**
+ * generate_product_env_buf() - Build key=value text buffer from EEPROM data
+ * @buf: Target buffer to hold env file contents
+ * @buf_size: Size of target buffer
+ *
+ * Return: Length of generated buffer on success, or negative on error
+ */
+static int generate_product_env_buf(char *buf, size_t buf_size)
+{
+    struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+    int len = 0;
+    int i;
+
+    /* Ensure EEPROM data is valid */
+    if (do_board_detect() != 0) {
+        pr_err("Error: Failed to read EEPROM for PRODUCT.ENV creation\n");
+        return -1;
+    }
+
+    /* Standard product fields */
+    len += snprintf(buf + len, buf_size - len, "version=%04x\n", ep->version);
+    len += snprintf(buf + len, buf_size - len, "serial=%.*s\n", PERLE_SERIAL_LEN, ep->serial);
+    len += snprintf(buf + len, buf_size - len, "prod_id=%.*s\n", PERLE_PROD_ID_LEN, ep->prod_id);
+    len += snprintf(buf + len, buf_size - len, "model=%.*s\n", PERLE_MODEL_LEN, ep->model);
+    len += snprintf(buf + len, buf_size - len, "ssid=%.*s\n", PERLE_SSID_LEN, ep->ssid);
+    len += snprintf(buf + len, buf_size - len, "password=%.*s\n", PERLE_PASSWORD_LEN, ep->password);
+
+    /* Wi-Fi MAC Addresses */
+    for (i = 0; i < PERLE_WIFI_MAC_ADDR_CNT; i++) {
+        len += snprintf(buf + len, buf_size - len, "wifi_mac%d=%pM\n",
+                        i, ep->wifi_mac_addr[i]);
+    }
+
+    /* Ethernet MAC Addresses */
+    for (i = 0; i < PERLE_ETH_MAC_ADDR_CNT; i++) {
+        len += snprintf(buf + len, buf_size - len, "eth_mac%d=%pM\n",
+                        i, ep->eth_mac_addr[i]);
+    }
+
+    return len;
+}
+
+/**
+ * write_product_env_file() - Save PRODUCT.ENV file to a storage filesystem
+ * @ifname: Interface type (e.g., "mmc")
+ * @dev_part: Device and partition string (e.g., "1:1" or "0:1")
+ * @filepath: Target filename (e.g., "PRODUCT.ENV" or "/boot/PRODUCT.ENV")
+ */
+int write_product_env_file(const char *ifname, const char *dev_part, const char *filepath)
+{
+    char env_buffer[2048] = { 0 };
+    loff_t actwrite;
+    int len;
+    int ret;
+
+    len = generate_product_env_buf(env_buffer, sizeof(env_buffer));
+    if (len <= 0)
+        return -1;
+
+    /* Bind filesystem handler (FAT, EXT4, etc.) */
+    ret = fs_set_blk_dev(ifname, dev_part, FS_TYPE_ANY);
+    if (ret) {
+        pr_err("PRODUCT.ENV: Failed to set device %s %s\n", ifname, dev_part);
+        return ret;
+    }
+
+    /* Write buffer to file */
+    ret = fs_write(filepath, (ulong)env_buffer, 0, len, &actwrite);
+    if (ret) {
+        pr_err("PRODUCT.ENV: Failed to write file %s\n", filepath);
+        return ret;
+    }
+
+    printf("PRODUCT.ENV: Successfully wrote %lld bytes to %s:%s/%s\n",
+           actwrite, ifname, dev_part, filepath);
+
+    return 0;
+}
+#endif
+#endif
+
+#ifdef CONFIG_BOARD_LATE_INIT
+int board_late_init(void)
+{
+	if (IS_ENABLED(CONFIG_PERLE_I2C_BOARD_DETECT)) {
+		setup_board_eeprom_env();
+		setup_serial();
+		set_env_mac_addr();
+
+		/* Write PRODUCT.ENV to eMMC partition 0:2 */
+		write_product_env_file("mmc", "0:2", "PRODUCT.ENV");
+	}
+
+	return 0;
+}
+#endif
+
+#define CTRLMMR_USB0_PHY_CTRL	0x43004008
+#define CORE_VOLTAGE		0x80000000
+
+#ifdef CONFIG_SPL_BOARD_INIT
+void spl_board_init(void)
+{
+	u32 val;
+	/* Set USB PHY core voltage to 0.85V */
+	val = readl(CTRLMMR_USB0_PHY_CTRL);
+	val &= ~(CORE_VOLTAGE);
+	writel(val, CTRLMMR_USB0_PHY_CTRL);
+
+	/* Init DRAM size for R5/A53 SPL */
+	dram_init_banksize();
+}
+#endif
diff --git a/board/perle/igos/igos.env b/board/perle/igos/igos.env
new file mode 100644
index 00000000000..1f48d4501a0
--- /dev/null
+++ b/board/perle/igos/igos.env
@@ -0,0 +1,59 @@
+#include <environment/ti/ti_armv7_common.env>
+#include <environment/ti/mmc.env>
+#include <environment/ti/k3_dfu_combined.env>
+#include <environment/ti/nand.env>
+#if CONFIG_CMD_REMOTEPROC
+#include <environment/ti/k3_rproc.env>
+#endif
+
+mtdids=nand0=omap2-nand.0
+mtdparts=omap2-nand.0:2m(NAND.tiboot3),2m(NAND.tispl),2m(NAND.tiboot3.backup),4m(NAND.u-boot),256k(NAND.u-boot-env),256k(NAND.u-boot-env.backup),-(NAND.file-system)
+
+findfdt=
+	setenv name_fdt perle/k3-am642-${board_prod_id}-${board_model}.dtb;
+	setenv fdtfile ${name_fdt}
+name_kern=Image
+console=ttyS0,115200n8
+args_all=setenv optargs earlycon=ns16550a,mmio32,0x02830000 ${mtdparts}
+run_kern=booti ${loadaddr} ${rd_spec} ${fdtaddr}
+
+boot=mmc
+mmcdev=0
+bootpart=0:2
+bootdir=/boot
+loadbootenv=fatload mmc ${bootpart} ${loadaddr} ${bootenvfile}
+rd_spec=-
+
+rproc_fw_binaries= 0 /lib/firmware/am64-main-r5f0_0-fw 1 /lib/firmware/am64-main-r5f0_1-fw
+
+args_usb=run finduuid;setenv bootargs console=${console}
+	${optargs}
+	root=PARTUUID=${uuid} rw
+	rootfstype=${mmcrootfstype}
+init_usb=run args_all args_usb
+get_fdt_usb=load usb ${bootpart} ${fdtaddr} ${bootdir}/${name_fdt}
+get_overlay_usb=
+	fdt address ${fdtaddr};
+	fdt resize 0x100000;
+	for overlay in $name_overlays;
+	do;
+	load usb ${bootpart} ${dtboaddr} ${bootdir}/${overlay} && fdt apply
+	${dtboaddr};
+	done;
+get_kern_usb=load usb ${bootpart} ${loadaddr}
+	${bootdir}/${name_kern}
+get_fit_usb=load usb ${bootpart} ${addr_fit}
+	${bootdir}/${name_fit}
+usbboot=setenv boot usb;
+	setenv bootpart 0:2;
+	usb start;
+	run findfdt;
+	run init_usb;
+	run get_kern_usb;
+	run get_fdt_usb;
+	run run_kern;
+
+#if CONFIG_TI_ICSSG_PRUETH
+fw_storage_interface=mmc
+fw_dev_part=1:2
+#endif
