+	led_lte_green {
+		gpio-hog;
+		gpios = <61 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "LED-LTE-GREEN";
+	};
+	led_wifi_red {
+		gpio-hog;
+		gpios = <64 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "LED-WIFI-RED";
+	};
+	led_wifi_blue {
+		gpio-hog;
+		gpios = <47 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "LED-WIFI-BLUE";
+	};
+	led_wifi_green {
+		gpio-hog;
+		gpios = <58 GPIO_ACTIVE_HIGH>;
+		output-low;
+		line-name = "LED-WIFI-GREEN";
+	};
+};
+
+&main_gpio1 {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_gpio1_digital_pins>;
+};
+
+&sdhci0 {
+	/* emmc */
+	non-removable;
+	ti,driver-strength-ohm = <50>;
+	disable-wp;
+};
+
+&sdhci1 {
+    status = "disabled";
+};
+
+&usbss0 {
+	ti,vbus-divider;
+	ti,usb2-only;
+};
+
+&usb0 {
