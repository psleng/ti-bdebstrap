 #ifdef CONFIG_BOARD_LATE_INIT
+/*
+ * perle_eeprom_field() - copy a fixed-length EEPROM field to a C string
+ *
+ * EEPROM character fields are not guaranteed to be NUL terminated, so copy
+ * at most @src_len printable bytes and stop at the first NUL / non-printable
+ * byte. The result is always NUL terminated.
+ */
+static void perle_eeprom_field(char *dst, size_t dst_sz, const char *src,
+			       size_t src_len)
+{
+	size_t i, n = 0;
+
+	for (i = 0; i < src_len && n < dst_sz - 1; i++) {
+		char c = src[i];
+
+		if (c < 0x20 || c > 0x7e)
+			break;
+		dst[n++] = c;
+	}
+	dst[n] = '\0';
+}
+
+static void perle_smbios_set(void *fdt, const char *path, const char *prop,
+			     const char *val)
+{
+	int off = fdt_path_offset(fdt, path);
+
+	if (off < 0)
+		return;
+	fdt_setprop_string(fdt, off, prop, val);
+}
+
+/*
+ * perle_smbios_fixup() - push EEPROM identity into the DMI/SMBIOS tables
+ *
+ * lib/smbios.c builds the DMI tables from the /sysinfo/smbios/* properties in
+ * the control FDT (see k3-am642-igos-u-boot.dtsi) plus the serial# env var.
+ * The DT properties are padded placeholders; overwrite them here with the live
+ * EEPROM values. Every value is shorter than its placeholder, so
+ * fdt_setprop_string() rewrites it in place -- the relocated control FDT has no
+ * spare room to grow a property.
+ */
+static void perle_smbios_fixup(void)
+{
+	struct perle_am_eeprom *ep = PERLE_AM6_EEPROM_BD_INFO_DATA;
+	void *fdt = (void *)gd->fdt_blob;
+	char prod_id[PERLE_PROD_ID_LEN + 1];
+	char model[PERLE_MODEL_LEN + 1];
+	char sku[PERLE_SKU_LEN + 1];
+	char serial[PERLE_SERIAL_LEN + 1];
+	char rev[PERLE_BOARD_REV_LEN + 1];
+	char product[PERLE_PROD_ID_LEN + PERLE_MODEL_LEN + 2];
+
+	if (do_board_detect()) {
+		strcpy(prod_id, DEFAULT_PROD_ID);
+		strcpy(model, DEFAULT_MODEL_ID);
+		sku[0] = '\0';
+		serial[0] = '\0';
+		rev[0] = '\0';
+	} else {
+		perle_eeprom_field(prod_id, sizeof(prod_id), ep->prod_id,
+				   PERLE_PROD_ID_LEN);
+		perle_eeprom_field(model, sizeof(model), ep->model,
+				   PERLE_MODEL_LEN);
+		perle_eeprom_field(sku, sizeof(sku), ep->sku, PERLE_SKU_LEN);
+		perle_eeprom_field(serial, sizeof(serial), ep->serial,
+				   PERLE_SERIAL_LEN);
+		perle_eeprom_field(rev, sizeof(rev), ep->board_revision,
+				   PERLE_BOARD_REV_LEN);
+	}
+
+	if (prod_id[0] && model[0])
+		snprintf(product, sizeof(product), "%s %s", prod_id, model);
+	else
+		snprintf(product, sizeof(product), "%s%s", prod_id, model);
+
+	/* SMBIOS type 1 Serial Number + UUID are taken from serial# */
+	if (serial[0])
+		env_set("serial#", serial);
+
+	if (!fdt || fdt_check_header(fdt))
+		return;
+
+	perle_smbios_set(fdt, "/sysinfo/smbios/system", "product", product);
+	if (sku[0])
+		perle_smbios_set(fdt, "/sysinfo/smbios/system", "sku", sku);
+
+	perle_smbios_set(fdt, "/sysinfo/smbios/baseboard", "product", product);
+
+	/* Both System and Baseboard Version report the EEPROM board revision */
+	if (rev[0]) {
+		perle_smbios_set(fdt, "/sysinfo/smbios/system", "version",
+				 rev);
+		perle_smbios_set(fdt, "/sysinfo/smbios/baseboard", "version",
+				 rev);
+	}
+}
