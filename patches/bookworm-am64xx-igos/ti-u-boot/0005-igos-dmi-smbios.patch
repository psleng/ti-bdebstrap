+/*
+ * SMBIOS/DMI source node (igos only).
+ *
+ * The u-boot,sysinfo-smbios device makes lib/smbios.c read these properties
+ * for the DMI tables. Property values below are padded placeholders: board
+ * code (board/perle/igos/igos.c) overwrites them at runtime from the EEPROM
+ * using fdt_setprop_string(), which only ever shrinks them in place (the
+ * relocated control FDT has no spare room to grow).
+ */
+/ {
+	sysinfo {
+		compatible = "u-boot,sysinfo-smbios";
+
+		smbios {
+			system {
+				manufacturer = "Perle Systems";
+				product = "placeholder-system-product-padxxxxxxxxxxxxxxxxxxx";
+				version = "0000xxxx";
+				family = "iGOS";
+				sku = "placeholder-sku-paddingx";
+			};
+
+			baseboard {
+				manufacturer = "Perle Systems";
+				product = "placeholder-baseboard-product-pxxxxxxxxxxxxxxxxxx";
+				version = "0000xxxxxxxxxxxx";
+			};
+
+			chassis {
+				manufacturer = "Perle Systems";
+			};
+		};
+	};
+};
